  "keyFeatures": [
    "Azure Resource Graph inventory synchronization with snapshot history and enrichment",
    "Cost Management integration with actual/amortized cost, FOCUS v1.0 charge ledger, and anomaly detection",
    "Flux Signals — versioned deterministic ARG optimization rule engine with confidence scoring",
    "Ask Flux — governed conversational AI assistant backed by 19 bounded server-side tools",
    "Multi-source VM right-sizing using Azure Monitor, LogicMonitor, and Advisor corroboration",
    "Virtual tags for governed cost allocation without Azure native tag write-back",
    "Durable inventory drift detection with median/MAD statistical baselines",
    "Role-based access with Microsoft Entra app roles and App Service managed identity",
    "Continuous delivery via Azure Pipelines with workload-identity federation",
    "Rill-compatible semantic layer with governed metrics, measures, and DuckDB dashboards"
  ],
